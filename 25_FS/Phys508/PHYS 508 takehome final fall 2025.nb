   3.9743036866755714`*^9},ExpressionUUID->"362b7c2a-3752-401d-a7ff-\
50d249f6e47a"],

Cell[TextData[{
 "a) A 3-force ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["F", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "65595a41-7501-45e3-8dca-52851c1c0c6a"],
 " is applied to a relativistic particle moving at velocity/c of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Beta]", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"5d2a0d02-eda7-4064-ab98-a7b2a4e5c1df"],
 ".  The angle between ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["F", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a3869c54-6797-442d-9838-a565bba2f6ea"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Beta]", "\[RightVector]"], TraditionalForm]],
  ExpressionUUID->"0d80f581-73e2-483d-a1a9-3f26153a148d"],
 " is 45 degrees.  What is the angle between the resulting acceleration ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["a", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "a62c1961-0613-4a06-acd4-5dd4b3b9f290"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["F", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "d7a8a440-e2e6-4574-a71d-089965246d83"],
 "?  \nExpress your result in terms of the mass ",
 StyleBox["m, \[Gamma]  ",
  FontSlant->"Italic"],
 "etc. \nb) Show, using the Euler-Lagrange equations, that the relativistic  \
Lagrangian L= ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"-", " ", "m"}], " ", 
     SuperscriptBox["c", "2"]}], "\[Gamma]"], TraditionalForm]],
  ExpressionUUID->"c65a2b78-f7f6-438f-9c17-719e092f4056"],
 " gives the correct 3-vector equation of motion for a free particle, where, \
as usual,  ",
 Cell[BoxData[
  RowBox[{"\[Gamma]", " ", "=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       OverscriptBox["\[Beta]", "\[RightVector]"], ".", 
       OverscriptBox["\[Beta]", "\[RightVector]"]}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], ")"}]]}]],ExpressionUUID->
  "f9808df7-e9b8-4d39-a670-1b69a3c0a643"]
}], "Text",
 CellChangeTimes->{{3.973798057686687*^9, 3.9737982268329487`*^9}, {
  3.973798259997045*^9, 3.973798281123432*^9}, {3.973798325586267*^9, 
  3.9737983345588427`*^9}, {3.9737983665348463`*^9, 3.973798451912236*^9}, {
  3.973798516638649*^9, 3.973798524855886*^9}, {3.973798616396266*^9, 
  3.973798619625551*^9}, {3.97379867731481*^9, 3.97379885249347*^9}, {
  3.973798908821498*^9, 
  3.973798963508497*^9}},ExpressionUUID->"4f4ed321-8ed7-4eda-bac5-\
cd39af228c9a"],

Cell[TextData[{
 "In lecture 17 notebook 0), we derived ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma]", 
         StyleBox["m", "TI"], 
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["F", "TI"], "\[RightVector]"], "-", 
         OverscriptBox["\[Beta]", "\[RightVector]"], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["F", "TI"], "\[RightVector]"], "\[CenterDot]", 
             OverscriptBox["\[Beta]", "\[RightVector]"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma m \\vec a = \\vec F - \\vec \\beta \\left(\\vec F \\cdot \\vec \
\\beta\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2bca5311-49d4-ec41-93d0-3b6cd7c642e4"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Beta]", "\[LongEqual]", 
         SqrtBox[
          RowBox[{"1", "-", 
            FractionBox["1", 
             SuperscriptBox["\[Gamma]", "2"]]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\beta = \\sqrt{1 - {1 \\over \\gamma^2}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c7a2e41-f98b-4443-9a48-d789fee919c5"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["a", "TI"], "\[RightVector]"], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"\[Gamma]", 
            StyleBox["m", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["F", "TI"], "\[RightVector]"], "-", 
             OverscriptBox["\[Beta]", "\[RightVector]"], 
             RowBox[{"(", 
               FractionBox[
                RowBox[{
                  StyleBox["F", "TI"], 
                  StyleBox["B", "TI"]}], 
                SqrtBox["2"]], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\vec a = {1 \\over \\gamma m} \\left(\\vec F - \\vec \\beta \\left( \
{FB} \\over \\sqrt{2}\\right) \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f89b53f-a836-0c42-9aaa-3b4a97aa2565"],
 "\nThis vector stuff gets tough by hand. Maybe we just define some unit \
vectors and let wolfram do the work?"
}], "text answer",
 CellChangeTimes->{{3.9742487946171017`*^9, 3.9742488078809834`*^9}, {
   3.9744207250924416`*^9, 3.974420936482561*^9}, {3.974420970308052*^9, 
