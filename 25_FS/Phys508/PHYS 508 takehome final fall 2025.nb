Cell[TextData[{
 "Okay, we can make some reasonable estimates now. I suspect the result will \
be pretty small, so we\[CloseCurlyQuote]ll try to buff up ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2e0198e-9f73-9046-958f-3bc4de1578d5"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Omega]", 
        StyleBox["f", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\omega_f", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c5fb2e1-a01d-d246-aaaa-3dbe96b61e76"],
 ". Mass doesn\[CloseCurlyQuote]t matter for comparison since both formulae \
have linear mass dependence. For latitude, I\[CloseCurlyQuote]ll use my \
current location, although most of the storm drains here are rectangular, not \
circular."
}], "text answer",
 CellChangeTimes->{{3.9745141470203495`*^9, 3.9745141871214104`*^9}, {
  3.97451423492696*^9, 3.9745142994302864`*^9}, {3.9745147764057674`*^9, 
