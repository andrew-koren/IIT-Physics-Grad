Cell[TextData[{
 "Easy peasy. Now for some dynamics. Let\[CloseCurlyQuote]s use \[Theta] = 0 \
straight down.\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         StyleBox["I", "TI"], 
         SuperscriptBox["\[Omega]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "T = {1 \\over 2}I \\omega^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "656a3e22-8dcc-2b4f-a62f-8e30f3b891a5"],
 "\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["U", "TI"], "\[LongEqual]", "-", 
         FractionBox["3", "4"], 
         StyleBox["M", "TI"], 
         StyleBox["g", "TI"], 
         StyleBox["H", "TI"], "cos", "\[Theta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "U =- {3 \\over 4}MgH\\cos\\theta", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29daba1a-c32a-0a47-a674-05f434cd08f1"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         StyleBox["I", "TI"], 
         SuperscriptBox["\[Omega]", "2"], "+", 
         FractionBox["3", "4"], 
         StyleBox["M", "TI"], 
         StyleBox["g", "TI"], 
         StyleBox["H", "TI"], "cos", "\[Theta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathscr{L} ={1 \\over 2}I \\omega^2+{3 \\over 4}MgH\\cos\\theta", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9cfeae72-01d4-504f-b977-7b05d6d3824a"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Theta]", "\:0308"], "\[LongEqual]", "-", 
         FractionBox[
          RowBox[{"3", 
            StyleBox["M", "TI"], 
            StyleBox["g", "TI"], 
            StyleBox["H", "TI"]}], 
          RowBox[{"4", 
            StyleBox["I", "TI"]}]], "sin", "\[Theta]", "\[LongEqual]", 
         FractionBox[
          RowBox[{"5", 
            StyleBox["g", "TI"], 
            StyleBox["H", "TI"]}], 
          RowBox[{"4", 
            SuperscriptBox[
             StyleBox["H", "TI"], "2"], "+", 
            SuperscriptBox[
             StyleBox["R", "TI"], "2"]}]], "sin", "\[Theta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\ddot{\\theta}=-{3MgH \\over 4I}\\sin \\theta={5gH \\over 4H^2 + \
R^2}\\sin \\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "665992d4-cb01-a348-b949-1f75cb750cf8"],
 "\nThe period ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"2", "\[Pi]"}], "\[Lambda]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "T = {2 \\pi \\over\\lambda}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "545d7463-604c-5747-9a09-faf9e30202bf"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Theta]", "\:0308"], "\[LongEqual]", "-", 
         SuperscriptBox["\[Lambda]", "2"], "\[Theta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ddot{\\theta}=-\\lambda^2 \\theta", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c266fc8-51c0-134f-9196-24df8500494f"],
 ", so our period is\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         FractionBox["1", 
          SqrtBox["5"]], 
         FractionBox[
          RowBox[{"2", "\[Pi]"}], 
          SqrtBox[
           FractionBox[
            RowBox[{
              StyleBox["g", "TI"], 
              StyleBox["H", "TI"]}], 
            RowBox[{"4", 
              SuperscriptBox[
               StyleBox["H", "TI"], "2"], "+", 
              SuperscriptBox[
               StyleBox["R", "TI"], "2"]}]]]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T = {1 \\over \\sqrt 5} {2 \\pi\\over \\sqrt{gH \\over 4H^2 + R^2}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92681697-a905-c641-9650-1696f31540a3"]
}], "text answer",
 CellChangeTimes->{{3.974389484176388*^9, 3.974389495638672*^9}, {
  3.9743896253287544`*^9, 3.9743896322562294`*^9}, {3.9743898481030006`*^9, 
