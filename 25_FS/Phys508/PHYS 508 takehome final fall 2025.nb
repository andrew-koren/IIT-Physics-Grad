Cell[CellGroupData[{

Cell[TextData[StyleBox["Problem 4 Normal modes", "Subsubsection"]], \
"Subsubsection",
 CellChangeTimes->{{3.973796900519372*^9, 3.973796905654414*^9}, {
  3.9737971058599367`*^9, 3.973797184225312*^9}, {3.9737972203647833`*^9, 
  3.9737976367120647`*^9}, {3.973797675761602*^9, 3.9737976777936363`*^9}, {
  3.973799048807621*^9, 3.973799051878167*^9}, {3.973849583099309*^9, 
  3.97384959741761*^9}, {3.974249817804222*^9, 3.9742498237948513`*^9}, {
  3.974303849867525*^9, 
  3.974303852125189*^9}},ExpressionUUID->"3c6becb3-fb36-c74f-a25f-\
a12cbc43bc75"],

Cell[TextData[{
 "Three masses in a line (say, the x-axis) are connected by springs of equal \
spring  constant ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", but the assembly is otherwise free to move (not attached to walls).  The \
two masses on the ends are of equal mass ",
 StyleBox["m",
  FontSlant->"Italic"],
 ", but the middle one is different, of mass ",
 StyleBox["M",
  FontSlant->"Italic"],
 ".  Consider only motions along the x-axis.\na) write down the Lagrangian \
for this system in terms of coordinates x1, x2, x3\nb) calculate the normal \
modes frequencies of vibration (eigenvalues) and modes (eigenvectors). \nc) \
If you get a zero frequency mode, what does that mean?"
}], "Text",
 CellChangeTimes->{{3.9737977671175413`*^9, 
  3.9737980379234543`*^9}},ExpressionUUID->"edf147f0-d00d-40b7-93f6-\
12f945ba6fd0"],

Cell[TextData[{
 "No mention of natural length here. Lets just use ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], 
         StyleBox["k", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"\[CapitalDelta]", 
              StyleBox["x", "TI"]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "{1 \\over 2} k( \\Delta x)^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "566092b7-1226-3f4c-9e45-d96b3e29b6b1"],
 "\n-> Lecture 15\nOur kinetic & potential energy are\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         FractionBox[
          StyleBox["m", "TI"], "2"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], "1", "2"], "+", 
         FractionBox[
          StyleBox["M", "TI"], "2"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], "2", "2"], "+", 
         FractionBox[
          StyleBox["m", "TI"], "2"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], "3", "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T = {m \\over 2} \\dot{x}_1^2+{M \\over 2} \\dot{x}_2^2+{m \\over 2} \
\\dot{x}_3^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d035309-9422-4746-9e18-e9f328f1d16b"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["U", "TI"], "\[LongEqual]", 
         FractionBox[
          StyleBox["k", "TI"], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["x", "TI"], "1"], "-", 
              SubscriptBox[
               StyleBox["x", "TI"], "2"]}], ")"}], "2"], "+", 
         FractionBox[
          StyleBox["k", "TI"], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["x", "TI"], "2"], "-", 
              SubscriptBox[
               StyleBox["x", "TI"], "3"]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "U = {k \\over 2}(x_1-x_2)^2 + {k \\over 2} (x_2 - x_3)^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e7d8de1-2743-1142-a560-453138280a47"],
 "\nThe fully expanded Lagrangian is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         StyleBox["T", "TI"], "-", 
         StyleBox["U", "TI"], "\[LongEqual]", 
         FractionBox[
          StyleBox["m", "TI"], "2"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], "1", "2"], "+", 
         FractionBox[
          StyleBox["M", "TI"], "2"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], "2", "2"], "+", 
         FractionBox[
          StyleBox["m", "TI"], "2"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], "3", "2"], "+", 
         FractionBox[
          StyleBox["k", "TI"], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["x", "TI"], "1"], "-", 
              SubscriptBox[
               StyleBox["x", "TI"], "2"]}], ")"}], "2"], "+", 
         FractionBox[
          StyleBox["k", "TI"], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox[
               StyleBox["x", "TI"], "2"], "-", 
              SubscriptBox[
               StyleBox["x", "TI"], "3"]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "L = T-U ={m \\over 2} \\dot{x}_1^2+{M \\over 2} \\dot{x}_2^2+{m \\over \
2} \\dot{x}_3^2+{k \\over 2}(x_1-x_2)^2 + {k \\over 2} (x_2 - x_3)^2", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7725b6a1-a6c3-c049-acc0-2570a793e8d3"],
 "\nThe problem specifically says to use ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["x", "TI"], "2"], ",", 
         SubscriptBox[
          StyleBox["x", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "x_1,x_2,x_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cffdd927-956f-204c-836e-52bfa858b529"],
 ", not CM coordinates which I don\[CloseCurlyQuote]t think work for three \
body anyways. We\[CloseCurlyQuote]ll look for harmonic solutions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["i", "TI"], "\[Prime]\[Prime]"], "\[LongEqual]", 
         SubsuperscriptBox["\[Omega]", 
          StyleBox["i", "TI"], "2"], 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x_i'' = \\omega^2_i x_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fddcfca-bbf6-d34b-b8e3-0aaa8a9490ae"]
}], "text answer",
 CellChangeTimes->{{3.9742483500596905`*^9, 3.974248394251463*^9}, {
   3.9742487436837864`*^9, 3.974248745978506*^9}, {3.9742498887986336`*^9, 
   3.9742498978727436`*^9}, {3.974304974407318*^9, 3.974305001025316*^9}, {
   3.9743050962129536`*^9, 3.9743050992376804`*^9}, {3.9743051613518276`*^9, 
   3.9743052110477753`*^9}, {3.9743052493746967`*^9, 3.97430530227087*^9}, {
   3.9743076823816605`*^9, 3.974307691974636*^9}, {3.9743077656460514`*^9, 
   3.9743078401676617`*^9}, {3.9743078981498737`*^9, 3.974307986466263*^9}, {
   3.974308117292959*^9, 3.9743081201323204`*^9}, {3.9743082190530796`*^9, 
   3.974308220754627*^9}, {3.9743082942310276`*^9, 3.974308308906193*^9}, {
   3.974309042541479*^9, 3.9743091710027065`*^9}, {3.974309336948223*^9, 
   3.9743093392852*^9}, {3.974309377483507*^9, 3.9743093945944595`*^9}, {
   3.9743094716556454`*^9, 3.974309483709917*^9}, 3.974309530642254*^9, {
   3.974309636616987*^9, 
   3.9743096460850887`*^9}},ExpressionUUID->"ba010845-e94f-ed4c-937f-\
bf1a1e1ee9de"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x1", "=", 
   RowBox[{
    SubscriptBox["x", "1"], "[", "t", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x2", "=", 
   RowBox[{
    SubscriptBox["x", "2"], "[", "t", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x3", "=", 
   RowBox[{
    SubscriptBox["x", "3"], "[", "t", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"m", "/", "2"}], ")"}], " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"x1", ",", "t"}], "]"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"M", "/", "2"}], ")"}], " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"x2", ",", "t"}], "]"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"m", "/", "2"}], ")"}], " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"x3", ",", "t"}], "]"}], "^", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"U", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"k", "/", "2"}], ")"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x1", "-", "x2"}], ")"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"k", "/", "2"}], ")"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x2", "-", "x3"}], ")"}], "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"L", " ", "=", " ", 
    RowBox[{"T", "-", "U"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eom", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"L", ",", 
           RowBox[{"D", "[", 
            RowBox[{"qi", ",", "t"}], "]"}]}], "]"}], ",", "t"}], "]"}], "==", 
       RowBox[{"D", "[", 
        RowBox[{"L", ",", "qi"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"qi", ",", 
        RowBox[{"{", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"eom", " ", "//", "TableForm"}]}], "Input",
 CellChangeTimes->{{3.974309652809393*^9, 3.9743096741510506`*^9}, {
  3.9743097072928104`*^9, 3.9743098497825108`*^9}, {3.974309889779335*^9, 
  3.9743099178195305`*^9}, {3.9743100400031834`*^9, 3.9743102028946342`*^9}, {
