Cell[TextData[{
 "The nullspace is of course the eigenvectors to go along with the \
eigenvalues. Since we assumed harmonic solutions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["n", "TI"]], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "\[Omega]", 
            StyleBox["t", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "x_n = v_n e^{i\\omega t}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdc8de75-5519-8345-a8db-548d5ad80801"],
 ", the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Omega]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\omega=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7af8f4a-29d7-5443-bb19-d76dcbc783a3"],
 " solution yields the linear translation, while the other two are \
symmetric/antisymmetric. Any state can be decomposed into these three modes, \
although our choice of no natural length requires all three masses to be on \
top of each other to prevent oscillation. "
}], "text answer",
 CellChangeTimes->{{3.974321184844597*^9, 3.9743213576547146`*^9}, {
  3.974321421777872*^9, 3.9743216087379932`*^9}, {3.974321667221836*^9, 
  3.974321677355999*^9}, {3.974321715410219*^9, 3.9743217157773895`*^9}, {
  3.974321771820036*^9, 
  3.9743218140827065`*^9}},ExpressionUUID->"2bbde568-3aca-894f-936b-\
ffea057f6dbc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Problem 5  Relativity", "Subsubsection",
 CellChangeTimes->{{3.973798042127015*^9, 3.973798044005498*^9}, {
   3.973799056467107*^9, 3.973799066739492*^9}, {3.973799855420046*^9, 
