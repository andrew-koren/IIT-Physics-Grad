Cell["\t\t\t\t\tfigure 1c", "Text",
 CellChangeTimes->{{3.9737963336157618`*^9, 3.973796337601462*^9}, {
  3.973849561050395*^9, 
  3.973849561257893*^9}},ExpressionUUID->"ff2a8fc3-0036-4cf8-9c1b-\
b2ead3a13e6b"],

Cell[TextData[{
 "This is just a superposition of rotating on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Omega]", "^"], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["z", "TI"], "^"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat \\omega = \\hat z", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e551840-5e3d-824e-ba3c-2407872192cd"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Omega]", "^"], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["x", "TI"], "^"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat \\omega = \\hat x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9732c3e6-afd1-ca43-b541-db2a4db69d47"],
 ", with weights that put ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[Omega]", "\[RightVector]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\vec \\omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e00de60e-7ad3-4347-8b8d-c687e2cc8a6f"],
 " on the surface of the cone. We can normalize the vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Omega]", "^"], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["R", "TI"], ",", "0", ",", 
             StyleBox["H", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\hat\\omega = a(R,0,H)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "810b27c9-2a15-564d-99be-20d9c5f4182b"],
 " and then matrix multiply to get our on-axis moment of inertia. I think ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> "L", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e12c4d4e-5d01-7b4e-afd1-cf8e5966e4cd"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Omega]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e784794c-e5c3-a643-973c-4f9a3dff039a"],
 " will be unaligned in this basis.\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Omega]", "\[RightVector]"], "\[LongEqual]", 
         "\[Omega]", 
         OverscriptBox["\[Omega]", "^"], "\[LongEqual]", "\[Omega]", 
         RowBox[{"(", 
           FractionBox[
            RowBox[{
              OverscriptBox[
               StyleBox["x", "TI"], "^"], 
              StyleBox["R", "TI"], "+", 
              OverscriptBox[
               StyleBox["z", "TI"], "^"], 
              StyleBox["H", "TI"]}], 
            SqrtBox[
             RowBox[{
               SuperscriptBox[
                StyleBox["H", "TI"], "2"], "+", 
               SuperscriptBox[
                StyleBox["R", "TI"], "2"]}]]], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\vec \\omega = \\omega\\hat \\omega =\\omega\\left(\\hat x R + \\hat z \
H \\over \\sqrt{H^2+R^2} \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "667b15d9-a2be-0b4d-a538-9f9cd33d1587"],
 " \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["L", "TI"], "\[RightVector]"], "\[LongEqual]", 
         StyleBox["I", "TI"], 
         OverscriptBox["\[Omega]", "\[RightVector]"], "\[LongEqual]", 
         "\[Omega]", 
         RowBox[{"(", 
           FractionBox[
            RowBox[{
              SubscriptBox[
               StyleBox["I", "TI"], 
               RowBox[{
                 StyleBox["x", "TI"], 
                 StyleBox["x", "TI"]}]], 
              OverscriptBox[
               StyleBox["x", "TI"], "^"], 
              StyleBox["R", "TI"], "+", 
              SubscriptBox[
               StyleBox["I", "TI"], 
               RowBox[{
                 StyleBox["z", "TI"], 
                 StyleBox["z", "TI"]}]], 
              OverscriptBox[
               StyleBox["z", "TI"], "^"], 
              StyleBox["H", "TI"]}], 
            SqrtBox[
             RowBox[{
               SuperscriptBox[
                StyleBox["H", "TI"], "2"], "+", 
               SuperscriptBox[
                StyleBox["R", "TI"], "2"]}]]], ")"}], ")"}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\vec L = I \\vec\\omega = \\omega\\left(I_{xx}\\hat x R + I_{zz}\\hat \
z H \\over \\sqrt{H^2+R^2} \\right))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a6b0d271-9e0a-d74f-84c9-0151245522d0"],
 " thanks to our diagonal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["I", "TI"], TraditionalForm], "errors" -> {}, "input" -> "I", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "331b0025-df73-5e40-a400-fa7d4469bb8b"]
}], "text answer",
 CellChangeTimes->{{3.9743922472566814`*^9, 3.974392514965973*^9}, {
  3.9744120367938995`*^9, 3.97441203816848*^9}, {3.974412092680681*^9, 
  3.9744120975383186`*^9}, {3.9744125998537407`*^9, 3.974412610552643*^9}, {
