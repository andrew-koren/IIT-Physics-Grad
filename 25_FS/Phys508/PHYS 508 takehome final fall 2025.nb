Cell[CellGroupData[{

Cell["problem 2 Hamiltonian formulation", "Subsubsection",
 CellChangeTimes->{{3.973796515277597*^9, 3.973796516245644*^9}, {
  3.9737968538174267`*^9, 
  3.9737968586154747`*^9}},ExpressionUUID->"e386f065-5e75-4d04-b28d-\
512f343269e6"],

Cell["\<\
For the system described in problem 1a (swinging cone):
a) determine the generalized momentum that is conjugate to the angle \[Theta] \
of deviation of cone axis from vertical.   
b) Write down the Hamiltonian, expressed in the terms of the angle and \
generalized momentum. 
c) write down Hamilton\[CloseCurlyQuote]s equations of motion for this system
d) make the small angle approximation and write the approximate equations of \
motion, and solve them for theta as a function of time.\
\>", "Text",
 CellChangeTimes->{{3.97379656083558*^9, 3.973796651600348*^9}, {
  3.973796694758873*^9, 3.97379684253876*^9}, {3.9737969741166477`*^9, 
  3.9737970187554398`*^9}, {3.974249853350155*^9, 3.974249857311676*^9}, {
  3.9744137384898796`*^9, 
  3.9744137391266937`*^9}},ExpressionUUID->"9d48e226-5154-4607-bd5a-\
f1bb7092d7bd"],

Cell[TextData[{
 "Following Lecture 16 notebook 1,\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], "\[LongEqual]", "\[Theta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "q = \\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b85da306-ca0e-6941-8079-17b15564727b"],
 ", \t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", 
            OverscriptBox[
             StyleBox["q", "TI"], "."]}]], "\[LongEqual]", 
         StyleBox["I", "TI"], "\[Omega]", "\[Rule]", "\[Omega]", 
         "\[LongEqual]", 
         FractionBox[
          StyleBox["p", "TI"], 
          StyleBox["I", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p ={\\partial L \\over \\partial \\dot{q}} = I\\omega \\rightarrow \
\\omega = {p \\over I}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c2cbbc38-14c7-ff49-b463-867177cf14ee"],
 " \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "\[LongEqual]", 
         StyleBox["T", "TI"], "+", 
         StyleBox["U", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         StyleBox["I", "TI"], 
         SuperscriptBox["\[Omega]", "2"], "-", 
         FractionBox["3", "4"], 
         StyleBox["M", "TI"], 
         StyleBox["g", "TI"], 
         StyleBox["H", "TI"], "cos", "\[Theta]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "H=T+U={1 \\over 2}I \\omega^2-{3 \\over 4}MgH\\cos\\theta", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7fe7b122-18f5-3140-9367-a72b86f109fe"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["p", "TI"], "2"], 
          RowBox[{"2", 
            StyleBox["I", "TI"]}]], "-", 
         FractionBox["3", "4"], 
         StyleBox["M", "TI"], 
         StyleBox["g", "TI"], 
         StyleBox["H", "TI"], "cos", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "= {p^2 \\over 2I}  - {3 \\over 4} MgH \\cos q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66730def-b442-fb45-9d1e-a3b5690b9b60"],
 "\nThe rest explains itself."
}], "text answer",
 CellChangeTimes->{{3.9744137479075375`*^9, 3.9744137509563026`*^9}, {
   3.9744137910237064`*^9, 3.9744138065868397`*^9}, {3.9744139427602367`*^9, 
   3.97441396394532*^9}, {3.9744140618994904`*^9, 3.974414113975828*^9}, {
   3.9744142475689545`*^9, 3.974414257960573*^9}, 3.974414289598009*^9, {
