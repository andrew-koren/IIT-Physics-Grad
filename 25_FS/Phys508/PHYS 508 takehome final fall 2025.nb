Cell[CellGroupData[{

Cell["Problem 6", "Subsubsection",
 CellChangeTimes->{{3.973798966465605*^9, 
  3.973798972324119*^9}},ExpressionUUID->"b786af9b-4240-4422-add0-\
45ba34e3f4c9"],

Cell[TextData[{
 "a) A vat of fluid is uniformly rotated around a vertical axis at angular \
velocity \[Omega] in a uniform gravitational field ",
 StyleBox["g. ",
  FontSlant->"Italic"],
 "Give an expression for the height of the fluid as a function of radial \
distance from the axis of rotation.  Explain your equations and rationale \
clearly.  Can you think of a use for this?  \nb) Using reasonable estimates \
of velocities and sizes, calculate the magnitude of the Coriolis force for \
water going down a sink drain.  How does this compare with the gravitational \
force?"
}], "Text",
 CellChangeTimes->{{3.973799132705823*^9, 3.973799283460188*^9}, {
  3.973799865116028*^9, 3.97379997825308*^9}, {3.973849612907907*^9, 
  3.973849613507737*^9}},ExpressionUUID->"5d56ed93-ce5a-4b4a-9988-\
a7ab3d73b66d"],

Cell[TextData[{
 "Lecture 13-14\n\nA stationary vat has \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "\[LongEqual]", 
         StyleBox["m", "TI"], 
         StyleBox["g", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "F=mg", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "167302d6-5e79-f845-9ffd-e7652274f1b0"],
 ",\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", "\[Rho]", 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m = \\rho V", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e957a11-e3ac-d94d-8e02-005acb2ec6ca"],
 ",\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         StyleBox["V", "TI"], "/", 
         SubscriptBox[
          StyleBox["h", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "A = V / h_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76961a86-698d-2445-bfcb-88d30cfe2c9e"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "\[LongEqual]", 
         StyleBox["F", "TI"], "/", 
         StyleBox["A", "TI"], "\[LongEqual]", "\[Rho]", 
         StyleBox["g", "TI"], 
         SubscriptBox[
          StyleBox["h", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P = F/A = \\rho g h_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ed5385a-50ee-004f-8b5f-22445e931526"],
 "\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           StyleBox["h", "TI"], ")"}], "\[LongEqual]", "\[Rho]", 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["h", "TI"], "0"], "-", 
             StyleBox["h", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "P(h) = \\rho g (h_0 - h)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abfaf66a-3bdb-8d44-adfe-e0a15ac5e3bd"],
 "\nIn a rotating vat we need to introduce the frame-dependant centripetal \
force required to maintain uniform rotation. \nWe\[CloseCurlyQuote]ll come \
back to gravity in a bit.\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["v", "TI"], "\[LongEqual]", "\[Omega]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "v = \\omega r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "737e8d89-52e4-1142-9abd-cf69255f3b8b"],
 "\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["F", "TI"], 
          RowBox[{
            StyleBox["w", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["l", "TI"], 
            StyleBox["l", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["m", "TI"], 
            SuperscriptBox[
             StyleBox["v", "TI"], "2"]}], 
          StyleBox["r", "TI"]], "\[LongEqual]", 
         RowBox[{
           StyleBox["m", "TI"], 
           StyleBox["r", "TI"], 
           SuperscriptBox["\[Omega]", "2"]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "F_{wall} = {m v^2 \\over r}={mr\\omega^2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e9902626-a7a0-b049-9663-7e2ae55c04cc"],
 "\nThis equation works for a point mass, but we have a continuous fluid with \
density, so we\[CloseCurlyQuote]ll need to integrate\nFor a cylinder of \
water, the force of each bit of water ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["m", "TI"], "\[LongEqual]", "\[Rho]", 
         StyleBox["d", "TI"], 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dm = \\rho dV", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce2ffc72-d991-c14e-a0cf-5d6b8fab5f4a"],
 " is\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["F", "TI"], "\[LongEqual]", "\[Rho]", 
         StyleBox["r", "TI"], 
         SuperscriptBox["\[Omega]", "2"], 
         StyleBox["d", "TI"], 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dF = \\rho r \\omega^2 dV", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "05159977-e634-2d4f-b32f-c56310237357"],
 ", and we\[CloseCurlyQuote]ll use a small cut of wall  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["A", "TI"], "\[LongEqual]", "2", "\[Pi]", 
         StyleBox["r", "TI"], 
         StyleBox["d", "TI"], 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dA = 2\\pi r dh", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8875500-b767-834c-b26f-fbb1f6910863"],
 ". \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["V", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         StyleBox["d", "TI"], "\[Theta]", 
         StyleBox["d", "TI"], 
         StyleBox["r", "TI"], 
         StyleBox["d", "TI"], 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dV = r d\\theta dr dh", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa94667b-ba13-574b-80d5-45c5b8f0d357"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["P", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Rho]", 
            StyleBox["r", "TI"], 
            SuperscriptBox["\[Omega]", "2"], 
            StyleBox["r", "TI"], 
            StyleBox["d", "TI"], "\[Theta]", 
            StyleBox["d", "TI"], 
            StyleBox["r", "TI"], 
            StyleBox["d", "TI"], 
            StyleBox["h", "TI"]}], 
          RowBox[{"2", "\[Pi]", 
            StyleBox["r", "TI"], 
            StyleBox["d", "TI"], 
            StyleBox["h", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[Rho]", 
            StyleBox["r", "TI"], 
            SuperscriptBox["\[Omega]", "2"]}], 
          RowBox[{"2", "\[Pi]"}]], 
         StyleBox["d", "TI"], "\[Theta]", 
         StyleBox["d", "TI"], 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dP ={ \\rho r \\omega^2  rd\\theta dr dh \\over 2\\pi r dh}={\\rho r \
\\omega^2 \\over 2\\pi}d\\theta dr", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d58cf4e-56ff-3142-9191-895a1d1a3772"],
 ". \nContinuing to neglect gravity, we add up each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["P", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dP", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e205cac9-fc1b-a241-beb7-c52da8ba3524"],
 " from the center ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85816939-afd5-2b4c-90da-beea94a7d597"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["r", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "r=r_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3234ba0f-1a33-384c-9c08-5a7b8fd379d7"],
 " to get pressure on the wall.\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["t", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", 
          RowBox[{"2", "\[Pi]"}]], 
         SubsuperscriptBox["\[Integral]", "0", 
          StyleBox["r", "TI"]], 
         StyleBox["d", "TI"], 
         StyleBox["P", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Rho]\[Omega]", "2"], 
            SuperscriptBox[
             StyleBox["r", "TI"], "2"]}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "P_{rot}(r) = \\int_0^{2\\pi} \\int_0^{r} dP = {\\rho \\omega^2 \
r^2\\over 2 }", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79b6de05-e7a9-344c-9460-c3ec7d3f058e"],
 " pressure of water at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cdc060a2-83c1-444d-878b-0ae20a04a727"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["t", "TI"]}]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["r", "TI"], "0"], ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox["\[Rho]\[Omega]", "2"], 
         SubsuperscriptBox[
          StyleBox["r", "TI"], "0", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_{rot}(r_0) = { 1 \\over 2} \\rho \\omega^2 r_0^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "51ec31b3-a2b5-7f4d-a09d-e38d9691fc31"],
 " pressure on the wall by water does not depend on height.\nNow we just need \
to combine the two pressures to get the height. Gravity typically requires ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", "TI"], ",", 
             StyleBox["h", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["r", "TI"], "\[Prime]"], ",", 
             StyleBox["h", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "P(r,h)=P(r',h)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "655f7161-23c9-8949-86b6-f699d7ae7e01"],
 ", but to maintain static uniform rotation we need to enforce centripetal \
motion, meaning pressure from gravity conforms to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["r", "TI"], 
          StyleBox["o", "TI"], 
          StyleBox["t", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "P_{rot}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2540f781-90d6-8f4a-b477-13537c1552ce"],
 ". Our formula ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         StyleBox["h", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P(h)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0840cda2-082d-bc4b-9035-81b74524416f"],
 " isn\[CloseCurlyQuote]t ideal for this, so we\[CloseCurlyQuote]ll change to \
depth ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           StyleBox["d", "TI"], ")"}], "\[LongEqual]", "\[Rho]", 
         StyleBox["g", "TI"], 
         StyleBox["d", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "P(d)= \\rho g d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b80ecb72-92de-264b-b423-2ab15ff216a2"],
 ", or more precisely parameterize as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["g", "TI"], 
            StyleBox["r", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["v", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", "\[Rho]", 
         StyleBox["g", "TI"], 
         StyleBox["d", "TI"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_{grav}(r) = \\rho g d(r)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e59d5fa-c9d0-fe41-804d-107dd19bb426"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["t", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["g", "TI"], 
            StyleBox["r", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["v", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_{rot}(r) = P_{grav}(r)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d076cd1-0750-c542-bf5b-4fabe90a176a"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Rho]\[Omega]", "2"], 
            SuperscriptBox[
             StyleBox["r", "TI"], "2"]}], "2"], "\[LongEqual]", "\[Rho]", 
         StyleBox["g", "TI"], 
         StyleBox["d", "TI"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[Rule]", 
         StyleBox["d", "TI"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Omega]", "2"], 
            SuperscriptBox[
             StyleBox["r", "TI"], "2"]}], 
          RowBox[{"2", 
            StyleBox["g", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "{\\rho \\omega^2 r^2 \\over 2} = \\rho g d(r) \\rightarrow d(r) = \
{\\omega^2 r^2 \\over 2g}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e6306be-205b-784d-b489-8c2b1b61ef50"],
 "\nThis depth ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "(", 
         StyleBox["r", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "d(r)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a71d4469-3484-084d-babc-ee508013ded8"],
 " goes to zero for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7f3c5e61-d5ca-7644-9892-ec00b79a0747"],
 ", but that\[CloseCurlyQuote]s not an issue. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["t", "TI"]}]], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P_{rot}(0) = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "665ac44b-c2cb-db4a-98a8-aa996967f42e"],
 " implies we\[CloseCurlyQuote]re actually solving for pressure on the \
horizontal slice touching the bottom of the meniscus. Everything else should \
work out automatically, since we can shift downward by a distance ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1f3d4c1-beb6-2841-9681-42f555fa0f0b"],
 " simply by adding ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", 
         StyleBox["g", "TI"], 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho g h", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2447499-b534-c943-aa06-dfd25f4e7995"],
 " to the pressure. To verify this result, the pressure in the meniscus at a \
height ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["d", "TI"], "\[Prime]"], TraditionalForm], "errors" -> {}, 
     "input" -> "d'", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8d0e9ef-1ade-7d42-a718-4f88ac6e9636"],
 " above the minimum is \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["t", "TI"]}], "\[Prime]"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", 
          SubscriptBox[
           StyleBox["r", "TI"], 
           RowBox[{
             StyleBox["m", "TI"], 
             StyleBox["i", "TI"], 
             StyleBox["n", "TI"]}]], 
          StyleBox["r", "TI"]], "\[Rho]", 
         StyleBox["r", "TI"], 
         SuperscriptBox["\[Omega]", "2"], 
         StyleBox["d", "TI"], 
         StyleBox["r", "TI"], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox["\[Rho]\[Omega]", "2"], "2"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["r", "TI"], "2"], "-", 
             SubsuperscriptBox[
              StyleBox["r", "TI"], 
              RowBox[{
                StyleBox["m", "TI"], 
                StyleBox["i", "TI"], 
                StyleBox["n", "TI"]}], "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "P_{rot}'(r) = \\int_{r_{min}}^r \\rho r \\omega^2 dr = {\\rho \\omega^2 \
\\over 2} \\left( r^2 - r_{min}^2 \\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe47d0b2-386a-fb48-803e-11db0e0937ee"],
 ", \nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], 
        RowBox[{
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["n", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "r_{min}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7996d90-9fac-4843-8b3b-517d5dd0dfb9"],
 " is the minimum radius of water, since there is no water from the axis to  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["i", "TI"], 
            StyleBox["n", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          SqrtBox[
           RowBox[{"2", 
             StyleBox["g", "TI"], 
             SuperscriptBox[
              StyleBox["d", "TI"], "\[Prime]"]}]], "\[Omega]"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "r_{min} = {\\sqrt{2g d'}\\over \\omega}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e1db86cc-8556-ad4c-8ff9-5a2f8a469c35"],
 " according to our result. Then,\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["t", "TI"]}], "\[Prime]"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox["\[Rho]\[Omega]", "2"], 
            SuperscriptBox[
             StyleBox["r", "TI"], "2"]}], "2"], "-", "\[Rho]", 
         StyleBox["g", "TI"], 
         SuperscriptBox[
          StyleBox["d", "TI"], "\[Prime]"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["t", "TI"]}]], "-", "\[Rho]", 
         StyleBox["g", "TI"], 
         SuperscriptBox[
          StyleBox["d", "TI"], "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "P'_{rot}(r) = {\\rho \\omega^2 r^2 \\over 2} - \\rho g d' = P_{rot} - \
\\rho g d'", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca475b60-9d82-4d4d-bdba-57b4f2b5e558"],
 "\nwhich matches up the rotational pressure and gravitational pressure in \
the meniscus to our result at the meniscus. I think, if we derived this in \
terms of ",
 StyleBox["potential",
  FontSlant->"Italic"],
 " instead of ",
 StyleBox["pressure",
  FontSlant->"Italic"],
 ", we could have used equipotential ideas to skip the need to double-check \
this ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["r", "TI"], 
          StyleBox["o", "TI"], 
          StyleBox["t", "TI"]}], "\[Prime]"], TraditionalForm], 
     "errors" -> {}, "input" -> "P'_{rot}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f80e9eaa-835a-1544-8715-af71dec5acc9"],
 " works out the way we want to."
}], "text answer",
 CellChangeTimes->{{3.974248844503664*^9, 3.974248868269083*^9}, {
   3.9744239789285145`*^9, 3.974423999324888*^9}, {3.9744738686991463`*^9, 
   3.9744738826742687`*^9}, {3.9744739718657246`*^9, 3.974474030495451*^9}, {
   3.9744740761345615`*^9, 3.97447408431102*^9}, {3.9744741166121445`*^9, 
   3.974474121634945*^9}, {3.9744741584780807`*^9, 3.9744743349559174`*^9}, {
   3.9744743902205105`*^9, 3.974474397400608*^9}, {3.974474472812769*^9, 
   3.9744744783571587`*^9}, {3.974474554749565*^9, 3.9744746214699764`*^9}, {
   3.974474652889759*^9, 3.9744746548647327`*^9}, {3.9744747006798286`*^9, 
   3.974474775364834*^9}, {3.974474962120758*^9, 3.974474990782202*^9}, {
   3.9744750589961624`*^9, 3.9744750646570168`*^9}, {3.9744751058139267`*^9, 
   3.974475175242626*^9}, {3.9744752152962856`*^9, 3.9744752729474506`*^9}, {
   3.9744753152382736`*^9, 3.974475338442869*^9}, {3.974475414695965*^9, 
   3.9744754180654736`*^9}, {3.974475588428362*^9, 3.9744756113296566`*^9}, {
   3.9744757163792877`*^9, 3.974475768332453*^9}, {3.9744758351960125`*^9, 
   3.9744759995526943`*^9}, {3.974476034784956*^9, 3.9744760725270233`*^9}, {
   3.9744763670612736`*^9, 3.974476409012844*^9}, {3.974476517710661*^9, 
   3.9744765806441154`*^9}, {3.9744767807513885`*^9, 
   3.9744769004930954`*^9}, {3.974476985825239*^9, 3.974477040457844*^9}, {
   3.974477094696306*^9, 3.9744771152877865`*^9}, {3.9744771797674866`*^9, 
   3.974477263676342*^9}, {3.974477465907526*^9, 3.9744777580024376`*^9}, {
   3.974477811028269*^9, 3.974477813143425*^9}, {3.9745026626461964`*^9, 
   3.974502697800743*^9}, 3.97450274869825*^9, {3.974502829560217*^9, 
   3.9745028396671524`*^9}, {3.9745035334298134`*^9, 3.974503546631407*^9}, {
   3.9745047846643543`*^9, 3.974504824990242*^9}, {3.974505006779892*^9, 
   3.9745050115158596`*^9}, {3.9745052147665195`*^9, 3.974505298833046*^9}, {
   3.974505329614649*^9, 3.9745055200959816`*^9}, {3.9745055617217846`*^9, 
   3.97450556211915*^9}, 3.9745057016605644`*^9, {3.9745057849666824`*^9, 
   3.974505928337618*^9}, {3.9745059934766216`*^9, 3.974506013677025*^9}, {
   3.9745061336467113`*^9, 3.974506172604555*^9}, {3.974506217847273*^9, 
   3.97450647877717*^9}, {3.97450663928561*^9, 3.9745067585253983`*^9}, {
   3.974506832162224*^9, 3.9745068960642815`*^9}, {3.9745074663645725`*^9, 
   3.9745074972458057`*^9}, {3.974507570023447*^9, 3.9745076592907486`*^9}, {
   3.9745077129187164`*^9, 3.97450773293375*^9}, {3.974507787961897*^9, 
   3.974507876831053*^9}, {3.974507946311386*^9, 3.974508045011236*^9}, {
   3.974508106211479*^9, 3.9745081077611656`*^9}, {3.9745085524334354`*^9, 
   3.9745086148834457`*^9}, {3.9745086931862984`*^9, 
   3.97450870549374*^9}},ExpressionUUID->"0bc43a25-61af-2a4c-bbd8-\
cb1bf4cde596"],

Cell[TextData[{
 "Now for part b. In class we discussed that Coriolis forces have a big \
impact on hurricanes, but less of an effect on sink drains. The formula for \
rotating frame force is\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["F", "TI"], "\[Prime]"], "\[LongEqual]", 
         StyleBox["m", "TI"], 
         SuperscriptBox[
          StyleBox["a", "TI"], "\[Prime]"], "\[LongEqual]", 
         StyleBox["F", "TI"], 
         UnderscriptBox[
          UnderscriptBox[
           RowBox[{"-", 
             StyleBox["m", "TI"], 
             FractionBox[
              RowBox[{
                StyleBox["d", "TI"], 
                OverscriptBox["\[Omega]", "\[RightVector]"]}], 
              RowBox[{
                StyleBox["d", "TI"], 
                StyleBox["t", "TI"]}]], "\[Cross]", 
             SuperscriptBox[
              OverscriptBox[
               StyleBox["r", "TI"], "\[RightVector]"], "\[Prime]"]}], 
           "\[UnderBrace]", LimitsPositioning -> False], "Euler force", 
          LimitsPositioning -> False], 
         UnderscriptBox[
          UnderscriptBox[
           RowBox[{"-2", 
             StyleBox["m", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 OverscriptBox["\[Omega]", "\[RightVector]"], "\[Cross]", 
                 SuperscriptBox[
                  OverscriptBox[
                   StyleBox["v", "TI"], "\[RightVector]"], "\[Prime]"]}], 
               ")"}]}], "\[UnderBrace]", LimitsPositioning -> False], 
          "Corilois force", LimitsPositioning -> False], 
         UnderscriptBox[
          UnderscriptBox[
           RowBox[{"-", 
             StyleBox["m", "TI"], 
             OverscriptBox["\[Omega]", "\[RightVector]"], "\[Cross]", 
             RowBox[{"(", 
               RowBox[{
                 OverscriptBox["\[Omega]", "\[RightVector]"], "\[Cross]", 
                 SuperscriptBox[
                  OverscriptBox[
                   StyleBox["r", "TI"], "\[RightVector]"], "\[Prime]"]}], 
               ")"}]}], "\[UnderBrace]", LimitsPositioning -> False], 
          "centrifugal", LimitsPositioning -> False]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "F' =ma' = F \\underbrace{-m {d  \\vec \\omega \\over dt} \\times \\vec \
r'}_{\\text{Euler force}} \\underbrace{-2m\\left( \\vec \\omega \\times \\vec \
v' \\right)}_{\\text{Corilois force} }\\underbrace{-m \\vec \\omega \\times \
\\left( \\vec \\omega \\times \\vec r' \\right)}_{\\text{centrifugal}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "77acde17-9b40-5047-bd2c-a31ce37ac8e8"],
 "\nFor a moving point mass on the surface of the earth, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[Omega]", "\[RightVector]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\vec \\omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83f5d0a6-2e77-4a4f-b5ff-9b8fc7582cba"],
 " is the rotation of the earth, and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        OverscriptBox[
         StyleBox["v", "TI"], "\[RightVector]"], "\[Prime]"], 
       TraditionalForm], "errors" -> {}, "input" -> "\\vec v'", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae540df7-7897-504d-aecf-4a7cb3b37314"],
 " is the apparent velocity. We only care about the inward pointing force \
component (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["F", "TI"], "\[RightVector]"], 
        StyleBox["g", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\vec F_g", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4d953cf-140c-b249-9cfb-b412e933ff54"],
 " is just ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], 
         StyleBox["g", "TI"], 
         OverscriptBox[
          StyleBox["z", "TI"], "^"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "mg \\hat z", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "192ad983-123a-fc43-a908-3b3dda7968ee"],
 "). Do we need an integral for a sink drain? Let\[CloseCurlyQuote]s say a \
fluid rotates uniformly at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Omega]", 
        StyleBox["f", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\omega_{f}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "31635a00-3d97-3b4a-877c-6e21dbc2f731"],
 " with total mass ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> "M", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8c50d54-9ed0-5648-b137-4dde5483f804"],
 ". I think we can approximate the force using a ring, but a disk isn\
\[CloseCurlyQuote]t that much more complicated. We assume a radially uniform \
density by saying the water is deep. \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          OverscriptBox[
           StyleBox["v", "TI"], "\[RightVector]"], "\[Prime]"], 
         "\[LongEqual]", 
         SubscriptBox[
          OverscriptBox["\[Omega]", "\[RightVector]"], 
          StyleBox["f", "TI"]], "\[Cross]", 
         OverscriptBox[
          StyleBox["r", "TI"], "\[RightVector]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\vec v' = \\vec \\omega_f \\times \\vec r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a40dbc96-a47b-bf42-9245-0f6951042507"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "\[LongEqual]", "-2", 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox["\[Omega]", "\[RightVector]"], "\[Cross]", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  OverscriptBox["\[Omega]", "\[RightVector]"], 
                  StyleBox["f", "TI"]], "\[Cross]", 
                 OverscriptBox[
                  StyleBox["r", "TI"], "\[RightVector]"]}], ")"}]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "F = -2M (\\vec \\omega \\times (\\vec \\omega_{f} \\times \\vec r))", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8970b4c-ad0c-3740-9d50-cc19b33f20cc"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], 
         StyleBox["F", "TI"], "\[LongEqual]", "-2", "\[Sigma]", 
         StyleBox["d", "TI"], 
         StyleBox["A", "TI"], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox["\[Omega]", "\[RightVector]"], "\[Cross]", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  OverscriptBox["\[Omega]", "\[RightVector]"], 
                  StyleBox["f", "TI"]], "\[Cross]", 
                 OverscriptBox[
                  StyleBox["r", "TI"], "\[RightVector]"], 
                 RowBox[{"(", 
                   RowBox[{
                    StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}]}], ")"}]}], 
           ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "dF = -2 \\sigma dA \\left(\\vec \\omega\\times (\\vec \\omega_{f} \
\\times \\vec r(r,\\theta))\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8eabd8b6-4cab-d24e-81c7-d0a51816f489"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", "-2", 
         FractionBox[
          StyleBox["M", "TI"], 
          RowBox[{"\[Pi]", 
            SuperscriptBox[
             StyleBox["R", "TI"], "2"]}]], 
         StyleBox["r", "TI"], 
         StyleBox["d", "TI"], 
         StyleBox["r", "TI"], 
         StyleBox["d", "TI"], "\[Theta]", 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox["\[Omega]", "\[RightVector]"], "\[Cross]", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  OverscriptBox["\[Omega]", "\[RightVector]"], 
                  StyleBox["f", "TI"]], "\[Cross]", 
                 OverscriptBox[
                  StyleBox["r", "TI"], "\[RightVector]"], 
                 RowBox[{"(", 
                   RowBox[{
                    StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}]}], ")"}]}], 
           ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "= -2 {M \\over \\pi R^2} r dr d\\theta \\left(\\vec \\omega\\times \
(\\vec \\omega_{f} \\times \\vec r(r,\\theta))\\right)", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a5dd951-3eb5-b84d-a686-7a280757e00d"],
 "\nand then we just integrate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[Rule]", "2", "\[Pi]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "0\\rightarrow2\\pi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "65f27435-256b-ce42-9ed5-02b71c84d352"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[Rule]", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "0\\rightarrow R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d47a004d-cc3c-4845-a565-259b9d137bd6"],
 ".\n\nWe have lots of design parameters we care about, so we\
\[CloseCurlyQuote]ll write the integral into Mathematica, setting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["z", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat z", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39b9bf71-ea32-7a41-ab0d-c2f34fe0b516"],
 " vertical (aligned with gravity) and computing the earth\[CloseCurlyQuote]s \
rotation direction relative to some ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dbc0bc52-21a4-734d-9029-535d0d24f98d"],
 " "
}], "text answer",
 CellChangeTimes->{{3.974508119391226*^9, 3.974508209424946*^9}, {
  3.9745083097814617`*^9, 3.974508316241455*^9}, {3.974508710013727*^9, 
  3.9745087226884956`*^9}, {3.9745087763437023`*^9, 3.974508805104006*^9}, {
  3.9745090531637936`*^9, 3.9745091028338356`*^9}, {3.974509202282467*^9, 
  3.974509262758251*^9}, {3.974509436647209*^9, 3.974509539057461*^9}, {
  3.9745096989693146`*^9, 3.974509761167431*^9}, {3.974509866247402*^9, 
  3.9745099935976677`*^9}, {3.974510232187786*^9, 3.974510241598812*^9}, {
  3.974510362510212*^9, 3.9745104167295933`*^9}, {3.9745104782596703`*^9, 
  3.974510492979704*^9}, {3.97451077961598*^9, 3.9745107831600857`*^9}, {
  3.9745108482801285`*^9, 3.9745108498056984`*^9}, {3.9745110937414036`*^9, 
  3.9745110954302692`*^9}, {3.9745111687105103`*^9, 3.974511346934288*^9}, {
  3.9745113891146317`*^9, 3.9745113916600094`*^9}, {3.974512612740103*^9, 
  3.9745126497745953`*^9}},ExpressionUUID->"514e91bd-6de9-8a4c-b533-\
214c29e23c62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"earthvec", " ", "=", " ", 
   RowBox[{"\[Omega]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", " ", "0", ",", " ", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rvec", " ", "=", " ", 
   RowBox[{"r", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", " ", "0"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flush", " ", "=", " ", 
   RowBox[{"\[Omega]f", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"dF", " ", "=", " ", 
  RowBox[{
   RowBox[{"-", "2"}], 
   RowBox[{"M", "/", "Pi"}], " ", 
   RowBox[{"R", "^", "2"}], "  ", 
   RowBox[{"(", 
    RowBox[{"earthvec", " ", "\[Cross]", " ", 
     RowBox[{"(", 
      RowBox[{"flush", " ", "\[Cross]", " ", "rvec"}], ")"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"coriolisF", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"dF", "*", "r"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "0", ",", "R"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.974511897842697*^9, 3.9745119767549934`*^9}, {
  3.974512010184908*^9, 3.97451201173473*^9}, {3.9745120741419106`*^9, 
  3.9745123616092377`*^9}, {3.9745124109940624`*^9, 3.9745124647184715`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"4fa5d499-9c9f-a14f-990a-41e10dd27f49"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"2", " ", "M", " ", "r", " ", 
     SuperscriptBox["R", "2"], " ", "\[Omega]", " ", "\[Omega]f", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "\[Pi]"], ",", 
   FractionBox[
    RowBox[{"2", " ", "M", " ", "r", " ", 
     SuperscriptBox["R", "2"], " ", "\[Omega]", " ", "\[Omega]f", " ", 
     RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "\[Pi]"], ",", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"2", " ", "M", " ", "r", " ", 
      SuperscriptBox["R", "2"], " ", "\[Omega]", " ", "\[Omega]f", " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "\[Pi]"]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.974512353268839*^9, 3.9745123622182007`*^9}, {
   3.97451244817243*^9, 3.9745124659845486`*^9}, 3.9745162733835373`*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"da2c6146-19d3-b44f-913e-d30e251f6186"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{{3.974512353268839*^9, 3.9745123622182007`*^9}, {
   3.97451244817243*^9, 3.9745124659845486`*^9}, 3.974516273453514*^9},
 CellLabel->"Out[68]=",ExpressionUUID->"8542a29f-7e26-e04f-a4ce-9a5344676043"]
}, Open  ]],

Cell[TextData[{
 "Uhm... I definitely saw that coming. Unless we calculate the tiny change in \
\[Phi] with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["r", "TI"], "\[RightVector]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\vec r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ebec1c9-8b55-6f45-845d-d461dbb49e13"],
 ", any linear force on one side of the rotating fluid will counteract the \
linear force on the other side. I probably should have just stuck with a \
point mass. We should find torque, of course, but that makes comparing with \
gravity weird. Let\[CloseCurlyQuote]s find a linear force by integrating \
across half the disk, and the force on the other half will of course be the \
opposite direction."
}], "text answer",
 CellChangeTimes->{{3.9745124867492657`*^9, 3.9745124941893425`*^9}, {
  3.974512919514675*^9, 3.9745130403835697`*^9}, {3.974513417133644*^9, 
  3.974513445683712*^9}, {3.9745135781198215`*^9, 3.974513586003788*^9}, {
  3.9745138421980953`*^9, 3.974513855568226*^9}, {3.974513896970278*^9, 
  3.9745139297218456`*^9}, {3.9745139639003315`*^9, 3.974513977510147*^9}, {
  3.9745141911404457`*^9, 3.974514227640381*^9}, {3.9745178099254894`*^9, 
  3.9745178128504868`*^9}},ExpressionUUID->"724e423c-8382-c249-a03e-\
1bfeec4b6396"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"d\[Tau]", " ", "=", " ", 
     RowBox[{"rvec", " ", "\[Cross]", " ", "dF"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"coriolis\[Tau]", " ", "=", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"d\[Tau]", " ", "r"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "R"}], "}"}]}], "]"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"coriolisFup", " ", "=", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"dF", "*", "r"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", 
        RowBox[{
         RowBox[{"-", "Pi"}], "/", "2"}], ",", 
        RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "R"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"coriolisFdn", "=", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"dF", "*", "r"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Theta]", ",", 
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{
         RowBox[{"-", "Pi"}], "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "R"}], "}"}]}], "]"}]}]}]}]], "Input",
