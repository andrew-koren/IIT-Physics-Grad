  3.9745156499139805`*^9}},ExpressionUUID->"6d0de850-4aed-a044-a4a2-\
d015f79a9403"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kenLat", " ", "=", " ", 
   RowBox[{"CityData", "[", 
    RowBox[{"\"\<Kenosha\>\"", ",", " ", "\"\<Latitude\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"drainRadius", " ", "=", " ", 
   RowBox[{"Quantity", "[", 
    RowBox[{"6", ",", " ", "\"\<Inches\>\""}], "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"drainRadiusSI", " ", "=", " ", 
   RowBox[{
    RowBox[{"UnitConvert", "[", 
     RowBox[{"drainRadius", ",", "\"\<meters\>\""}], "]"}], " ", "//", 
    "QuantityMagnitude"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"drain\[Omega]", " ", "=", " ", "10"}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"fast", " ", "but", " ", "reasonable"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"earthOmega", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Pi", " ", "/", " ", 
     RowBox[{"PlanetData", "[", 
      RowBox[{"\"\<Earth\>\"", ",", " ", "\"\<RotationPeriod\>\""}], 
      "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"earthOmegaSI", " ", "=", " ", 
    RowBox[{
     RowBox[{"UnitConvert", "[", 
      RowBox[{"earthOmega", ",", " ", 
       RowBox[{"1", "/", "\"\<Seconds\>\""}]}], "]"}], " ", "//", " ", 
     "QuantityMagnitude"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"numericForce", " ", "=", " ", 
  RowBox[{"coriolisFup", " ", "/.", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"R", " ", "->", " ", "drainRadiusSI"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", " ", "->", " ", "kenLat"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Sine", " ", "takes", " ", "care", " ", "of", " ", "degrees"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Omega]", "->", " ", "earthOmegaSI"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Omega]f", "->", " ", "drain\[Omega]"}]}], "}"}]}]}]}], "Input",\

