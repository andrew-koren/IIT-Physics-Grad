Cell[TextData[{
 "Funnily enough, the lecture notebook also features ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             StyleBox["H", "TI"], ",", 
             SubscriptBox[
              StyleBox["L", "TI"], 
              StyleBox["z", "TI"]]}], "]"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "[H,L_z]=0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4256ea3-49a3-8347-ad1b-b2aa4372a520"],
 " and I could copy/paste the explanation here. Put simply, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], 
        StyleBox["z", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "L_z", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4bdd0f1e-5ec4-0244-81e6-818ea5c53dd3"],
 " doesn\[CloseCurlyQuote]t change in time while ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["H", "TI"], TraditionalForm], "errors" -> {}, "input" -> "H", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5b9eeb19-c6f3-4243-b0a0-402508b5b9f9"],
 " doesn\[CloseCurlyQuote]t change with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["z", "TI"], TraditionalForm], "errors" -> {}, "input" -> "z", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a67b45b-094a-7844-8946-9ffe2c9c516d"],
 "-rotation. The other two brackets look similar, but differ in sign and an \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "/", 
         StyleBox["y", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x/y", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a51789f-a65a-0e4b-9f21-15c5f47d8519"],
 " term. This value is the (negative) time change of angular momentum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             StyleBox["H", "TI"], ",", 
             SubscriptBox[
              StyleBox["L", "TI"], 
              StyleBox["i", "TI"]]}], "]"}], "\[LongEqual]", "-", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["L", "TI"], "."], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "[H,L_i]=-\\dot{L}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "42daec91-9206-8741-b742-0fd9e4e5a7d3"],
 ", and that difference in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "/", 
         StyleBox["y", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x/y", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06712c43-1de0-5841-af1b-262dc81b715f"],
 " means total angular momentum isn\[CloseCurlyQuote]t conserved. In fact, it \
looks like angular momentum is only constant while ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", 
         StyleBox["y", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x=y", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00ed4329-4f20-304a-9d7d-6cbadaeb2979"],
 " "
}], "text answer",
 CellChangeTimes->{{3.9744187405188236`*^9, 3.9744188322029552`*^9}, {
   3.9744190813141174`*^9, 3.974419133941368*^9}, {3.974419261505348*^9, 
   3.974419299801998*^9}, {3.974419336760481*^9, 3.9744193783472996`*^9}, 
   3.974419416765663*^9, {3.9744194501858025`*^9, 3.9744195288697147`*^9}, {
   3.974419571479887*^9, 3.9744195730156136`*^9}, {3.974419668831066*^9, 
