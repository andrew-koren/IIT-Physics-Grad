Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"harmonic", "=", 
    RowBox[{
     RowBox[{"eom", "/.", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"qi", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "->", 
         RowBox[{
          RowBox[{"-", "\[Omega]2"}], " ", "qi"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"qi", ",", 
          RowBox[{"{", 
           RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "}"}]}], "]"}]}], "//",
      "Simplify"}]}], ";", 
   RowBox[{"eomMatrix", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"CoefficientArrays", "[", 
        RowBox[{"harmonic", ",", 
         RowBox[{"{", 
          RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], "//", "Normal"}], " ", "//", " ", 
     "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
