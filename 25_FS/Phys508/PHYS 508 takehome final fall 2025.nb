Cell[TextData[{
 "Unfortunately, I couldn\[CloseCurlyQuote]t get ",
 Cell[BoxData[
 "Eigenvalues"], "InlineCode",ExpressionUUID->
  "3c56ac5e-31f4-874b-bf63-581f9dc4c1bd"],
 " to work, so we have to ask Wolfram to solve ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["M", "TI"], "-", "\[Lambda]", 
             StyleBox["I", "TI"]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\det(M-\\lambda I)=0", 
     "state" -> "Boxes"|>,
