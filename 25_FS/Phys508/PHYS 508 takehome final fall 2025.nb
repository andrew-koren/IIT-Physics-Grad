Cell[CellGroupData[{
Cell[" Take home Final Exam PHYS 508", "Subsection",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9737992981833563`*^9, 3.9737993202915783`*^9}, 
   3.973799673158923*^9, 3.97430198501264*^9, {3.9744177162892246`*^9, 
   3.974417717292944*^9}},ExpressionUUID->"b92fa00d-3e66-4aef-a9fe-\
e0142110ccba"],

Cell[TextData[{
 "Ground Rules:  Do the work all by yourself, and show it in full. You can \
use textbooks, class notes, Mathematica or analogous software.  But  don\
\[CloseCurlyQuote]t use AI/LLM software like ChatGPT or Gemini etc. Be \
prepared to explain all of your work if it were necessary.\n\nIf you have \
questions or find errors in the problems just email me at ",
 StyleBox["bunker@illinoistech.edu",
  FontWeight->"Bold"],
 ".\n\nPlease email the completed exam to me by ",
 StyleBox["noon on Sunday Dec 14, 2025",
  FontWeight->"Bold"],
 ".  If you need to hand it in on paper just put it in my departmental \
mailbox, but let me know by email that you did so. \n\nhave fun!  gb"
}], "Text",
 CellChangeTimes->{{3.973799330822176*^9, 3.9737993718621693`*^9}, {
  3.973799406682638*^9, 3.973799536075642*^9}, {3.973799570098055*^9, 
  3.9737997831146917`*^9}, {3.973849633702156*^9, 
  3.973849634300102*^9}},ExpressionUUID->"60e548fe-5b01-4e84-ab75-\
c318b2c54c3c"],

Cell["Less jarring in dark mode. -Andrew", "text answer",
 CellChangeTimes->{{3.974417732360836*^9, 
  3.9744178148858566`*^9}},ExpressionUUID->"a9778bf3-504e-9842-8406-\
6d4b3e633c9d"],

Cell[CellGroupData[{

Cell["Problem 1  Inertia tensor", "Subsubsection",
 CellChangeTimes->{{3.973796005410537*^9, 3.973796009308732*^9}, {
  3.973796862073597*^9, 
  3.9737968658882647`*^9}},ExpressionUUID->"e58b28b1-44d0-46e3-b910-\
54d8139508ef"],

Cell[TextData[{
 "A uniform cone of mass M, radius R and height H is suspended from its \
vertex in gravitational acceleration ",
 StyleBox["g",
  FontSlant->"Italic"],
 " on a frictionless pivot as shown in the figure below. It is displaced from \
the vertical so it swings back and forth. \na) write down a Lagrangian for \
its motion. Do not make the small angle approximation.  \nb) What is its \
frequency of small oscillations?  Express your result in terms of R, H, and \
g.  "
}], "Text",
 CellChangeTimes->{{3.973795238622908*^9, 3.973795262422229*^9}, {
  3.973795298540687*^9, 3.973795535873403*^9}, {3.9737955808256397`*^9, 
  3.973795697661199*^9}, {3.9737959270312967`*^9, 3.973795958765435*^9}, {
  3.973796001392157*^9, 3.973796001682049*^9}, {3.9737960374678507`*^9, 
  3.973796040335277*^9}, {3.973796294893859*^9, 3.973796318068697*^9}, {
  3.973796481915897*^9, 3.973796506222331*^9}, {3.9737966569451036`*^9, 
  3.973796681562538*^9}, {3.97379704021887*^9, 
  3.973797045754325*^9}},ExpressionUUID->"af22e84a-2ec3-4c0b-b65b-\
0ae75736b7a2"],

