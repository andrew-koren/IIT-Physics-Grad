Cell[BoxData[{
 RowBox[{
  RowBox[{"vecF", " ", "=", " ", 
   RowBox[{"F", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vec\[Beta]", "=", " ", 
   RowBox[{
    RowBox[{"\[Beta]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "0"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"veca", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"\[Gamma]", " ", "m"}], ")"}]}], 
    RowBox[{"(", 
     RowBox[{"vecF", "-", 
      RowBox[{"vec\[Beta]", 
       RowBox[{"(", 
        RowBox[{"vecF", ".", "vec\[Beta]"}], ")"}]}]}], ")"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"acceleration", " ", "3"}], "-", "vector"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cos\[Theta]", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"vecF", ".", "veca"}], "/", 
      RowBox[{"(", 
       RowBox[{"F", " ", 
        RowBox[{"Norm", "[", "veca", "]"}]}], ")"}]}], " ", "/.", " ", 
     RowBox[{
      RowBox[{"Abs", "[", "u_", "]"}], " ", "->", " ", "u"}]}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{"forceAccelAngle", " ", "=", " ", 
  RowBox[{"\[Theta]", " ", "==", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"ArcCos", "[", " ", 
      RowBox[{"cos\[Theta]", "/.", " ", 
       RowBox[{
        RowBox[{"\[Beta]", "^", "n_."}], "->", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
            RowBox[{"1", "/", 
             RowBox[{"\[Gamma]", "^", "2"}]}]}], "]"}], ")"}], "^", "n"}]}]}],
       " ", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"F", ">", "0"}], ",", " ", 
       RowBox[{"m", ">", "0"}], ",", " ", 
       RowBox[{"\[Gamma]", ">", "0"}]}], "}"}]}], "]"}]}]}]}], "Input",
