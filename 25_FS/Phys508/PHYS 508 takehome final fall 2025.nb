Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"a", " ", "bit", " ", "overkill", " ", "but", " ", "whatever"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"edgevec", " ", "=", " ", 
     RowBox[{"a", 
      RowBox[{"{", 
       RowBox[{"R", ",", " ", "0", ",", " ", "H"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"edgevec", " ", "/.", " ", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", "edgevec", "]"}], "==", "1"}], ",", " ", "a"}],
         " ", "]"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"omegavec", " ", "=", " ", 
     RowBox[{"\[Omega]", " ", "edgevec"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"angularMomentum", " ", "=", " ", 
     RowBox[{
      RowBox[{"IIpoint", " ", ".", " ", "omegavec"}], " ", "//", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kineticEnergy", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"angularMomentum", " ", ".", " ", "omegavec"}]}], " ", "//", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Angular Momentum: \>\"", ",", " ", 
     RowBox[{"angularMomentum", " ", "//", "MatrixForm"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Kinetic Energy: \>\"", ",", " ", "kineticEnergy"}], 
    "]"}]}]}]], "Input",
