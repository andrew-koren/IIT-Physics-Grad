Cell[CellGroupData[{

Cell["Problem 3 Poisson Bracket,  symmetry, conservation law", "Subsubsection",
 CellChangeTimes->{{3.9737968762573643`*^9, 3.973796878089676*^9}, {
   3.973799014901482*^9, 3.9737990307064753`*^9}, 
   3.9743037213894367`*^9},ExpressionUUID->"0e6494b3-47b2-4b63-a6b3-\
feaabd1463c9"],

Cell[TextData[{
 "A system in 3D has Hamiltonian \n\nH =  ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     OverscriptBox["p", "\[RightVector]"], ".", 
     OverscriptBox["p", "\[RightVector]"]}], 
    RowBox[{"2", "m"}]], TraditionalForm]],
  FontSize->18,ExpressionUUID->"11f71741-8543-483f-b7ea-f6f8e36f09a1"],
 "+ \[Gamma] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox["x", "4"]}], TraditionalForm]],ExpressionUUID->
  "0b18c4bc-bd34-4e6f-9f66-027570d2371e"],
 "+2 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "cfbfd54b-f9c0-4d9c-9feb-9125a20ab9bd"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "02f1ed7d-8559-47d3-8847-ec03081eb84c"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "4"], TraditionalForm]],ExpressionUUID->
  "3141dcf3-7184-412b-a43c-a140ed3afdab"],
 ")  where ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["p", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "05a43f02-2869-48d4-951b-4df5e72cf0ce"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["p", "x"], ",", 
      SubscriptBox["p", "y"]}]}]}], TraditionalForm]],ExpressionUUID->
  "bf6bac87-c853-432c-8db3-a88f1a1fd2ec"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "z"], TraditionalForm]],ExpressionUUID->
  "efbfd78d-3c0e-416d-af89-360b0ae728ef"],
 "), as usual. \n\n Calculate the Poisson bracket of H with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "x"], TraditionalForm]],ExpressionUUID->
  "d61728d0-17ec-4b27-9f8e-b842563ee8c4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "y"], TraditionalForm]],ExpressionUUID->
  "1c04a153-23f5-49b1-b395-7e49a0a196b5"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "z"], TraditionalForm]],ExpressionUUID->
  "f75537d1-f32e-4a12-b463-274a5d6c8b91"],
 "  and interpret the result. What do these results imply about conservation \
of the various components of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["L", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "977c6a3a-1230-4bdc-96c9-4a13096ae98d"],
 "?"
}], "Text",
 CellChangeTimes->{{3.973796900519372*^9, 3.973796905654414*^9}, {
   3.9737971058599367`*^9, 3.973797184225312*^9}, {3.9737972203647833`*^9, 
