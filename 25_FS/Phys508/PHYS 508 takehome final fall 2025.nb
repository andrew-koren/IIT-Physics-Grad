   3.9744198915782814`*^9, 3.974419905024172*^9}, 3.9744199431774883`*^9, {
   3.9744201020412445`*^9, 3.974420143916052*^9}, {3.9744201834016933`*^9, 
   3.974420184351927*^9}},ExpressionUUID->"eb93ae83-ab80-8f4b-89cd-\
