Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalH]", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"pvec", ".", "pvec"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "m"}], ")"}]}], "+", 
    RowBox[{"\[Gamma]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "4"}], "+", 
       RowBox[{"2", 
        RowBox[{"x", "^", "2"}], " ", 
        RowBox[{"y", "^", "2"}]}], "+", 
       RowBox[{"y", "^", "4"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PB", "[", 
   RowBox[{"F_", ",", "G_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"F", ",", 
        RowBox[{
        "rvec", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"G", ",", 
        RowBox[{
        "pvec", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "]"}]}], "-", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"G", ",", 
        RowBox[{
        "rvec", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{"F", ",", 
        RowBox[{
        "pvec", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
       "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PB", "[", 
    RowBox[{"\[ScriptCapitalH]", ",", "Lvec"}], "]"}], " ", "//", 
   "Simplify"}], " ", "//", "TableForm"}]}], "Input",
