Cell["\t\t\t\t\tfigure 1a", "Text",
 CellChangeTimes->{
  3.9743909254546833`*^9},ExpressionUUID->"50dde657-18bb-e445-8c9e-\
c0af4bd13e55"],

Cell[TextData[{
 "We covered The Cone in Lecture 11 notebook 3, although that was from the \
center of the base, not the point of the cone. We could transform, but only \
if we know the center of mass. The internet says it\[CloseCurlyQuote]s at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["H", "TI"], "/", "4"}], TraditionalForm], "errors" -> {}, 
     "input" -> "H/4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "08d4f5fe-2e69-af45-96cf-9496debafb6e"],
 " and I don\[CloseCurlyQuote]t care enough to do the integral myself."
}], "text answer",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.974325563861107*^9, 3.9743255857458057`*^9}, 
   3.9743853703477936`*^9, 3.974385698593668*^9, {3.974386289334568*^9, 
   3.9743863054604797`*^9}, {3.9743863837666264`*^9, 3.974386407879799*^9}, {
   3.974386787285227*^9, 3.9743869145907288`*^9}, {3.97438700710079*^9, 
   3.974387029806761*^9}, {3.9743870915877857`*^9, 3.974387155965317*^9}, {
   3.9743877890560017`*^9, 3.974387903186455*^9}, {3.9743879653206024`*^9, 
   3.9743880119735527`*^9}},ExpressionUUID->"3d4c1dbb-a21d-3e47-a4a6-\
6e188705b908"],

Cell[TextData[{
 "From this, we can translate over to the tip moment of inertia via \
generalized parallel axis theorem. Using ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["R", "TI"], "\[RightVector]"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"0", ",", "0", ",", 
             StyleBox["H", "TI"], "/", "4"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\vec R = (0,0,H/4)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a48852a3-391a-a448-abfd-d3644e10076a"],
 " as the center of mass, we\[CloseCurlyQuote]ll use ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["r", "TI"], "\[RightVector]"], ")"}], "\[LongEqual]", 
         StyleBox["I", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            OverscriptBox[
             StyleBox["r", "TI"], "\[RightVector]"], 
            RowBox[{
              StyleBox["s", "TI"], 
              StyleBox["e", "TI"], 
              StyleBox["p", "TI"]}]], ")"}], "+", 
         StyleBox["I", "TI"], 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["R", "TI"], "\[RightVector]"], ")"}]}], TraditionalForm],
      "errors" -> {}, "input" -> "I(\\vec r) = I(\\vec r_{sep}) + I(\\vec R)",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c31800a-0161-e74f-933e-ce3a49e4f7fd"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["r", "TI"], "\[RightVector]"], 
          RowBox[{
            StyleBox["s", "TI"], 
            StyleBox["e", "TI"], 
            StyleBox["p", "TI"]}]], "\[LongEqual]", "-", 
         OverscriptBox[
          StyleBox["R", "TI"], "\[RightVector]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\vec r_{sep} = - \\vec R", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47c2d474-8d65-fa41-8042-88395ffefc75"],
 " since we\[CloseCurlyQuote]re using the base as the origin."
}], "text answer",
 CellChangeTimes->{{3.9743879449222546`*^9, 3.9743879583785725`*^9}, {
  3.9743880385734196`*^9, 3.9743880891606293`*^9}, {3.9743886351207123`*^9, 
  3.9743886403841743`*^9}, {3.974388750229536*^9, 3.9743887916917686`*^9}, {
  3.9743888505966167`*^9, 3.974388892149122*^9}, {3.9743889238631687`*^9, 
  3.9743889348954105`*^9}},ExpressionUUID->"676d339f-ba1b-464a-897d-\
9359ab128815"],

