Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Constants", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"m", "=", "1"}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"\[HBar]", "=", "1"}], ";"}], "    ", "\n", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"a", "+", "b"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Wave", " ", "Numbers"}], "*)"}], "\n", 
   RowBox[{"\[Alpha]", ":=", 
    SqrtBox[
     FractionBox[
      RowBox[{"2", "m\[ScriptCapitalE]"}], 
      SuperscriptBox["\[HBar]", "2"]]]}], " ", 
   RowBox[{"(*", 
    RowBox[{"In", " ", "the", " ", "potential", " ", "well"}], "*)"}], "\n", 
   RowBox[{"\[Beta]", ":=", 
    SqrtBox[
     FractionBox[
      RowBox[{"2", "m", 
       RowBox[{"(", 
        RowBox[{"V", " ", "-", " ", "\[ScriptCapitalE]"}], ")"}]}], 
      SuperscriptBox["\[HBar]", "2"]]], " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"In", " ", "the", " ", "barrier"}], ",", " ", 
      RowBox[{"0", "<", "\[ScriptCapitalE]", "<", 
       SubscriptBox["V", "0"]}]}], "*)"}]}]}]}]], "Input",
