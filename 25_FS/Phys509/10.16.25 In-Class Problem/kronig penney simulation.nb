Cell[TextData[{
 "Note: both alpha and beta scale with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SqrtBox[
        StyleBox["m", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sqrt{m}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7cb9fb6d-d5fb-c146-a808-e4b37a664ba2"],
 ", so the band structure compresses as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["m", "TI"], TraditionalForm], "errors" -> {}, "input" -> "m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "260ba649-cdc4-1a41-8038-45af87d17f88"],
 " increases. Increasing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "V_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ddca12a-fad8-1c46-bb73-d96c3351522a"],
 " may appear to have the same effect, however this is due to rescaling of \
the x-axis."
}], "Text",
 CellChangeTimes->{{3.9696573563179016`*^9, 3.9696574720697136`*^9}, {
  3.96965751631485*^9, 3.9696575231998005`*^9}, {3.9696578558901196`*^9, 
  3.969657882615185*^9}},ExpressionUUID->"5a57c7e8-e416-d541-93f0-\
1d11ff3196dc"]
}, Open  ]],

