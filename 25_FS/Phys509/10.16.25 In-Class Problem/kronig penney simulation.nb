Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Fast", " ", "version", " ", "of", " ", "getAllowedIntervals", " ", "for", 
    " ", "Manipulate"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"getAllowedIntervals", "[", 
     RowBox[{"V0_", ",", "a_", ",", "b_", ",", "m_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"energyStep", "=", "0.005"}], ",", "energyValues", ",", 
        "functionValues", ",", "validRegions", ",", 
        RowBox[{"intervalStart", "=", "None"}], ",", 
        RowBox[{"intervals", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"energyValues", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"energyStep", ",", 
          RowBox[{"V0", "-", "energyStep"}], ",", "energyStep"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"functionValues", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"rhs", "[", 
           RowBox[{"#", ",", "m", ",", "V0", ",", "a", ",", "b"}], "]"}], 
