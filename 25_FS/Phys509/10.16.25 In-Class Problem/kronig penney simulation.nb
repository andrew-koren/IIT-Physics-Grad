       RowBox[{"(", 
        RowBox[{
        "Wave", " ", "numbers", " ", "in", " ", "well", " ", "and", " ", 
         "barrier"}], ")"}], "--"}]}], "-"}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"From", " ", "the", " ", "Schrodinger", " ", "equation"}], ",", 
     RowBox[{
      RowBox[{"we", " ", "define", " ", 
       RowBox[{"k", "^", "2"}]}], "=", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"mE", "/", 
         RowBox[{"hbar", "^", "2."}]}], " ", "Solutions", " ", "are", " ", 
        "defined", " ", "with", " ", "hbar"}], "=", 
       RowBox[{"1", " ", "natural", " ", "units"}]}]}], ",", " ", 
     RowBox[{
     "although", " ", "mass", " ", "is", " ", "able", " ", "to", " ", "be", " ", 
      RowBox[{"changed", ".", "The"}], " ", "textbook", " ", "then", " ", 
      "uses", " ", "the", " ", "symbol", " ", "alpha", " ", "for", " ", "the",
       " ", "wave", " ", "number"}], ",", " ", 
     RowBox[{
      RowBox[{"so", " ", "alpha"}], "=", 
      RowBox[{"k", "."}]}]}], "*)"}], " ", 
   RowBox[{
    RowBox[{
     RowBox[{"alpha", "[", 
      RowBox[{"energy_", ",", " ", "m_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "*", "m", "*", "energy"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"beta", ":", 
      RowBox[{
      "Decay", " ", "constant", " ", "in", " ", "the", " ", "potential", " ", 
       "barrier", " ", 
       RowBox[{"(", 
        RowBox[{"E", "<", "V0"}], ")"}]}]}], ",", 
     RowBox[{"per", " ", 
      RowBox[{"Eq", ".", "8.147"}]}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"beta", "[", 
      RowBox[{"energy_", ",", " ", "m_", ",", " ", "V0_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "*", "m", "*", 
       RowBox[{"(", 
        RowBox[{"V0", "-", "energy"}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Dispersion"}]}], " ", "Relation", " ", "Function"}], ",", 
     RowBox[{"f", 
      RowBox[{"(", "Energy", ")"}]}], ",", 
     RowBox[{
      RowBox[{"per", " ", 
       RowBox[{"Eq", ".", 
        RowBox[{"8.167", "--"}]}]}], "-"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "RHS", " ", "of", " ", "the", " ", "equation", " ", "is", " ",
       "broken", " ", "into", " ", "two", " ", "terms", " ", "for", " ", 
      "better", " ", "readability"}], ",", 
     RowBox[{
     "matching", " ", "the", " ", "structure", " ", "of", " ", "the", " ", 
      "textbook", " ", 
      RowBox[{"equation", "."}]}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"rhsTerm1", "[", 
      RowBox[{"energy_", ",", "m_", ",", "V0_", ",", "a_", ",", "b_"}], "]"}],
      ":=", 
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{
        RowBox[{"beta", "[", 
         RowBox[{"energy", ",", "m", ",", "V0"}], "]"}], "*", "b"}], "]"}], "*", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"alpha", "[", 
         RowBox[{"energy", ",", "m"}], "]"}], "*", "a"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rhsTerm2", "[", 
      RowBox[{"energy_", ",", "m_", ",", "V0_", ",", "a_", ",", "b_"}], "]"}],
      ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"beta", "[", 
            RowBox[{"energy", ",", "m", ",", "V0"}], "]"}], "^", "2"}], "-", 
          RowBox[{
           RowBox[{"alpha", "[", 
            RowBox[{"energy", ",", "m"}], "]"}], "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"alpha", "[", 
           RowBox[{"energy", ",", "m"}], "]"}], " ", 
          RowBox[{"beta", "[", 
           RowBox[{"energy", ",", "m", ",", "V0"}], "]"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"Sinh", "[", 
       RowBox[{
        RowBox[{"beta", "[", 
         RowBox[{"energy", ",", "m", ",", "V0"}], "]"}], "*", "b"}], "]"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"alpha", "[", 
         RowBox[{"energy", ",", "m"}], "]"}], "*", "a"}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rhs", "[", 
      RowBox[{"energy_", ",", "m_", ",", "V0_", ",", "a_", ",", "b_"}], "]"}],
      ":=", 
     RowBox[{
      RowBox[{"rhsTerm1", "[", 
       RowBox[{"energy", ",", "m", ",", "V0", ",", "a", ",", "b"}], "]"}], "+", 
      RowBox[{"rhsTerm2", "[", 
       RowBox[{"energy", ",", "m", ",", "V0", ",", "a", ",", "b"}], "]"}]}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Generate"}]}], " ", "the", " ", 
      RowBox[{"Plot", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
