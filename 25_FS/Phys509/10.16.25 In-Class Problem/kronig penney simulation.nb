Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "This", " ", "cell", " ", "visualizes", " ", "the", " ", "energy", " ", 
      "band", " ", "structure", " ", "for", " ", "an", " ", "electron", " ", 
      "in", " ", "a", " ", "one"}], "-", 
     RowBox[{"dimensional", " ", "periodic", " ", "potential", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", " ", "crystal", " ", "lattice"}], ")"}], ".", "The"}], " ",
       "model", " ", "demonstrates", " ", "how", " ", "discrete", " ", 
      "energy", " ", "levels", " ", "of", " ", "isolated", " ", "atoms", " ", 
      "broaden", " ", "into", " ", "allowed", " ", "energy", " ", "bands", " ",
       "separated", " ", "by", " ", "forbidden", " ", 
      RowBox[{"gaps", ".", "The"}], " ", "core", " ", "of", " ", "the", " ", 
      "model", " ", "is", " ", "the", " ", "dispersion", " ", 
      RowBox[{"relation", ":", 
       RowBox[{"Cos", "[", 
        RowBox[{"K", " ", "d"}], "]"}]}]}]}], "=", 
    RowBox[{
     RowBox[{"f", 
      RowBox[{"(", "Energy", ")"}], " ", "\[IndentingNewLine]", "An", " ", 
      "energy", " ", "state", " ", "is", " ", "\"\<allowed\>\"", " ", "if", " ",
       "the", " ", "function", " ", "f", 
      RowBox[{"(", "Energy", ")"}], " ", "is", " ", "between"}], "-", 
     RowBox[{
     "1", " ", "and", " ", "1.", " ", "This", " ", "interactive", " ", "plot",
       " ", "visualizes", " ", "f", 
      RowBox[{"(", "Energy", ")"}], " ", "and", " ", "highlights", " ", 
      "these", " ", 
      RowBox[{"regions", ".", "Physical"}], " ", "constants", " ", 
      RowBox[{"(", 
       RowBox[{"hbar", ",", "mass"}], ")"}], " ", "are", " ", "set", " ", 
      "to", " ", "1", " ", "for", " ", 
      RowBox[{"simplicity", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "alpha", ",", "beta", ",", "rhs", ",", "rhsTerm1", ",", "rhsTerm2", ",", 
      "getAllowedIntervals"}], "]"}], ";"}], "\n", "\n", 
